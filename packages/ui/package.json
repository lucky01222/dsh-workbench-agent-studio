{
  "name": "dsh-workbench-agent-studio-ui",
  "version": "1.13.3",
  "description": "Agent Studio Web editor and authenticated API adapter",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "locale",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2 || 0.2.0-rc.2",
    "dsh-workbench-agent-studio-service": "1.13.3"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": "0.1.7-rc.2 || 0.2.0-rc.2",
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucky01222/dsh-workbench-agent-studio.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/lucky01222/dsh-workbench-agent-studio#readme",
  "bugs": {
    "url": "https://github.com/lucky01222/dsh-workbench-agent-studio/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "preset",
    "workflow"
  ],
  "publishConfig": {
    "access": "public"
  }
}
