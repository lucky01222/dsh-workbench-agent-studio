{
  "name": "dsh-workbench-agent-studio",
  "version": "1.13.3",
  "description": "Visual Agent Studio for DeepSeek Harness Web",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.mjs",
    "./policy": "./dist/policy.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/index.mjs",
    "dist/policy.mjs",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "screenshots.json",
    "media"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2 || 0.2.0-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:client": "node scripts/test-client.mjs",
    "pack:release": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "esbuild": "0.27.4",
    "immer": "10.1.1",
    "js-yaml": "4.2.0",
    "react": "18.3.1",
    "zod": "4.4.3",
    "zustand": "4.4.7"
  },
  "dependencies": {
    "dsh-workbench-agent-studio-service": "1.13.3",
    "dsh-workbench-agent-studio-runtime": "1.10.5",
    "dsh-workbench-agent-studio-ui": "1.13.3"
  },
  "bundledDependencies": [
    "dsh-workbench-agent-studio-service",
    "dsh-workbench-agent-studio-runtime",
    "dsh-workbench-agent-studio-ui"
  ],
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "dsh": "0.1.7-rc.2 || 0.2.0-rc.2",
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucky01222/dsh-workbench-agent-studio.git"
  },
  "homepage": "https://github.com/lucky01222/dsh-workbench-agent-studio#readme",
  "bugs": {
    "url": "https://github.com/lucky01222/dsh-workbench-agent-studio/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "preset",
    "workflow"
  ],
  "publishConfig": {
    "access": "public"
  }
}
